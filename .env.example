# ============================================================
# .env.example — Blog CodeIgniter 3
# ============================================================
# Copie este arquivo para .env e ajuste os valores conforme
# o ambiente que deseja utilizar (LOCAL ou DOCKER).
#
# Apenas UM bloco deve ficar ativo por vez.
# ============================================================

# LOCAL (Laragon / XAMPP / php -S)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=blog_codeigniter
DB_USERNAME=root
DB_PASSWORD=

# DOCKER
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=blog_codeigniter
# DB_USERNAME=blog_user
# DB_PASSWORD=blog_password
